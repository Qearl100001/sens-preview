      "activeBackground": {
        "$type": "color",
        "$description": "Figma 207:54681 功能色 06_选中背景默认；非色板阶",
        "$value": {
          "colorSpace": "srgb",
          "components": [0.9294117647, 0.9490196078, 0.9882352941],
          "alpha": 1,
          "hex": "#EDF2FC"
        }
      },
      "activeHoverBackground": {
        "$type": "color",
        "$description": "Figma 207:54681 功能色 07_选中背景悬停；非色板阶",
        "$value": {
          "colorSpace": "srgb",
          "components": [0.9607843137, 0.9725490196, 1],
          "alpha": 1,
          "hex": "#F5F8FF"
        }
      },
      "activeClickBackground": {
        "$type": "color",
        "$description": "Figma 207:54681 功能色 08_选中背景点击；非色板阶",
        "$value": {
          "colorSpace": "srgb",
          "components": [0.9019607843, 0.9294117647, 0.9803921569],
          "alpha": 1,
          "hex": "#E6EDFA"
        }
      },
      "activeShadow": {
        "$type": "color",
        "$description": "Figma 207:54681 功能色 09_点击投影 = 冰绽蓝/10 @ 0.2",
        "$value": {
          "hex": "#3170EB",
          "alpha": 0.2
        }
      },
