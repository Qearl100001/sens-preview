{
  "$schema": "sens.foundation.functional-skin.v1",
  "$description": "功能色换肤矩阵。导航品牌主题与功能色独立维护；旭日红、原野黄、沙丘金、云霞粉使用冰绽蓝功能色，避免品牌色承担成功、警告等操作语义。不收录链接 / 状态色。",
  "skin": {
    "green": {
      "primary": {
        "$type": "color",
        "$value": "{功能色.01_默认 @component-primary}"
      },
      "hover": {
        "$type": "color",
        "$value": "{功能色.02_悬停 @component-hover}"
      },
      "active": {
        "$type": "color",
        "$value": "{功能色.03_点击 @component-active}"
      },
      "disable": {
        "$type": "color",
        "$value": "{功能色.04_禁用 @component-disable}"
      },
      "disableHover": {
        "$type": "color",
        "$value": "{功能色.05_禁用悬停 @component-disable-hover}"
      },
      "activeBackground": {
        "$type": "color",
        "$value": "{功能色.06_选中背景默认 @component-active-background}"
      },
      "activeHoverBackground": {
        "$type": "color",
        "$value": "{功能色.07_选中背景悬停 @component-active-hover-background}"
      },
      "activeClickBackground": {
        "$type": "color",
        "$value": "{功能色.08_选中背景点击 @component-active-click-background}"
      },
      "activeShadow": {
        "$type": "color",
        "$value": "{功能色.09_点击投影 @component-active-shadow}"
      },
      "lightBackground": {
        "$type": "color",
        "$value": "{功能色.10_浅色背景 @component-light-background}"
      }
    },
    "blue": {
      "primary": {
        "$type": "color",
        "$value": "{基础色板.冰绽蓝.10}"
      },
      "hover": {
        "$type": "color",
        "$value": "{基础色板.冰绽蓝.08}"
      },
      "active": {
        "$type": "color",
        "$value": "{基础色板.冰绽蓝.12}"
      },
      "disable": {
        "$type": "color",
        "$value": "{基础色板.冰绽蓝.06}"
