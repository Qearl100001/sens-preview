              }
            ]
          }
        }
      },
      "side": {
        "background": {
          "$type": "gradient",
          "$extensions": {
            "sens": { "handle": "theme-side-background" }
          },
          "$value": {
            "type": "linear",
            "angle": 180,
            "stops": [
              { "color": "#FAFBFC", "position": 0 },
              { "color": "#F0F2F7", "position": 100 }
            ]
          }
        }
      },
      "title": {
        "background": {
          "$type": "color",
          "$value": "#F5F7FA"
        }
      },
      "page": {
        "background": {
          "$type": "color",
          "$value": "#F5F7FA"
        }
      },
      "accent": {
        "solid": {
          "$type": "color",
          "$description": "Figma 207:54681 冰绽蓝导航强调实色",
          "$value": "{基础色板.冰绽蓝.10}"
        },
        "subtle": {
          "$type": "color",
          "$description": "Figma 207:54681 导航选中/悬停浅底 rgba(49,112,235,0.1)",
          "$value": {
            "hex": "#3170EB",
            "alpha": 0.1
          }
        }
      },
      "handles": {
        "theme-top-funcMenu-background-hover": {
          "$type": "color",
          "$value": { "hex": "#3170EB", "alpha": 0.1 }
        },
        "theme-top-funcMenu-background-active": {
          "$type": "color",
          "$value": { "hex": "#3170EB", "alpha": 0.1 }
        },
        "theme-top-funcMenu-text-hover": {
          "$type": "color",
          "$value": "{基础色板.冰绽蓝.10}"
        },
        "theme-top-funcMenu-text-active": {
          "$type": "color",
          "$value": "{基础色板.冰绽蓝.10}"
        },
        "theme-top-funcMenu-icon-hover": {
          "$type": "color",
          "$value": "{基础色板.冰绽蓝.10}"
        },
        "theme-top-funcMenu-icon-active": {
          "$type": "color",
          "$value": "{基础色板.冰绽蓝.10}"
        },
        "theme-top-proMenu-background-active": {
          "$type": "color",
          "$value": { "hex": "#3170EB", "alpha": 0.1 }
        },
        "theme-top-proMenu-text-active": {
          "$type": "color",
          "$value": "{基础色板.冰绽蓝.10}"
        },
        "theme-top-menuLine-active": {
          "$type": "color",
          "$value": "{基础色板.冰绽蓝.10}"
        },
        "theme-side-background-active": {
          "$type": "color",
          "$value": { "hex": "#3170EB", "alpha": 0.1 }
        },
        "theme-side-text-active": {
          "$type": "color",
          "$value": "{基础色板.冰绽蓝.10}"
        },
        "theme-side-icon-active": {
          "$type": "color",
          "$value": "{基础色板.冰绽蓝.10}"
        },
        "theme-title-background": {
          "$type": "color",
          "$value": "#F5F7FA"
        },
        "body-background": {
          "$type": "color",
          "$value": "#F5F7FA"
        }
      }
    },
