{
  "$schema": "sens.foundation.navigation-theme.v1",
  "$description": "产品壳导航主题补充源。渐变与氛围层按 Figma 换肤表录入；主题色与功能色独立维护。当前共 12 套常规浅色主题：神策绿、冰绽蓝、原野黄、青柠绿、沙丘金、旭日红、极光绿、山水蓝、兰花紫、波光紫、云霞粉、子夜黑。",
  "theme": {
    "green": {
      "top": {
        "background": {
          "$type": "gradient",
          "$extensions": {
            "sens": { "handle": "theme-top-background" }
          },
          "$value": {
            "type": "linear",
            "angle": 135,
            "stops": [
              { "color": "#0F9670", "position": 0 },
              { "color": "#0D826D", "position": 100 }
            ]
          }
        },
        "atmosphere": {
          "$type": "gradient-stack",
          "$description": "顶导航氛围叠层；蓝肤复用同结构（白叠层 + 中性底线），随基础渐变换肤。",
          "$extensions": {
            "sens": { "handle": "theme-top-atmosphere" }
          },
          "$value": {
            "layers": [
              {
                "type": "radial",
                "geometry": "circle at 18% 62%",
                "stops": [
                  { "color": "{中性色.白.01 @white}", "alpha": 0.14, "position": 0 },
                  { "color": "transparent", "position": 34 }
                ]
              },
              {
                "type": "radial",
                "geometry": "circle at 82% -8%",
                "stops": [
                  { "color": "{中性色.白.01 @white}", "alpha": 0.12, "position": 0 },
                  { "color": "transparent", "position": 42 }
                ]
              },
              {
                "type": "linear",
                "geometry": "180deg",
                "stops": [
                  { "color": "transparent", "position": 0 },
                  { "color": "{主题色.顶导航.线.01_深 @theme-top-line-dack}", "alpha": 0.12, "position": 100 }
                ]
              }
            ]
          }
        }
      },
      "side": {
        "background": {
          "$type": "gradient",
          "$extensions": {
            "sens": { "handle": "theme-side-background" }
          },
          "$value": {
            "type": "linear",
            "angle": 180,
            "stops": [
              { "color": "#FAFCFC", "position": 0 },
              { "color": "#F0F7F6", "position": 100 }
            ]
          }
        }
      },
      "title": {
        "background": {
          "$type": "color",
          "$value": "#F5FAFA"
        }
      },
      "page": {
        "background": {
          "$type": "color",
          "$value": "#F2F7F7"
        }
      },
      "accent": {
        "solid": {
          "$type": "color",
          "$description": "导航品牌实色（选中字/图标/短线）",
          "$value": "{基础色板.神策绿.10}"
        },
        "subtle": {
          "$type": "color",
          "$description": "导航品牌浅底（选中/悬停菜单底 @0.1）",
          "$value": {
            "hex": "#00B280",
            "alpha": 0.1
          }
        }
      },
      "handles": {
        "$description": "绿肤品牌态走 Color.json 默认 handle；此表留空，消费时回落 getColorToken。"
      }
    },
    "blue": {
      "top": {
        "background": {
          "$type": "gradient",
          "$extensions": {
            "sens": { "handle": "theme-top-background" }
          },
          "$value": {
            "type": "linear",
            "angle": 135,
            "stops": [
              { "color": "#3B78C9", "position": 0 },
              { "color": "#305BB0", "position": 100 }
            ]
          }
        },
        "atmosphere": {
          "$type": "gradient-stack",
          "$description": "蓝表未单列氛围层；复用绿肤叠层结构，叠在蓝色基础渐变上。",
          "$extensions": {
            "sens": { "handle": "theme-top-atmosphere" }
          },
          "$value": {
            "layers": [
              {
                "type": "radial",
                "geometry": "circle at 18% 62%",
                "stops": [
                  { "color": "{中性色.白.01 @white}", "alpha": 0.14, "position": 0 },
                  { "color": "transparent", "position": 34 }
                ]
              },
              {
                "type": "radial",
                "geometry": "circle at 82% -8%",
                "stops": [
                  { "color": "{中性色.白.01 @white}", "alpha": 0.12, "position": 0 },
                  { "color": "transparent", "position": 42 }
                ]
              },
              {
                "type": "linear",
                "geometry": "180deg",
                "stops": [
                  { "color": "transparent", "position": 0 },
                  { "color": "{主题色.顶导航.线.01_深 @theme-top-line-dack}", "alpha": 0.12, "position": 100 }
