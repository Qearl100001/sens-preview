{
  "name": "sens-preview",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5173 --strictPort",
    "tokens:build": "node build-tokens.mjs",
    "tokens:check": "node scripts/check-tokens.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build": "npm run tokens:check && npm run typecheck && vite build",
    "build:agent-eval": "tsc && vite build -c vite.agent-eval.config.ts",
    "preview": "vite preview"
  },
  "dependencies": {
    "antd": "^5.21.0",
    "i18next": "^23.11.5",
    "pinyin-pro": "^3.28.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-i18next": "^14.1.2",
    "react-markdown": "^9.0.1",
    "react-router-dom": "^6.28.0",
    "remark-gfm": "^4.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.1.1",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "eslint": "^10.7.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "typescript": "^5.4.5",
    "typescript-eslint": "^8.65.0",
    "vite": "^5.3.1"
  }
}
